# Covers both candidate stacks until D-01 is resolved. Trim to the chosen
# language in BE-00 rather than carrying rules for a stack that was not picked.

# Environment and secrets
.env
.env.*
!.env.example
secrets/
*.pem
*.key

# Database dumps and exports — customer and financial data, never committed
*.dump
*.sql.gz
exports/
*.xlsx
*.xls
*.csv

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
dist/
build/

# --- Go ---
/bin/
*.exe
*.test
vendor/

# Logs
logs/
*.log

# OS and editors
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/
*.swp

# Redocly / npx cache
node_modules/

# openapi-typescript CI scratch output
api/.generated/
first.d.ts
